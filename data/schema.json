{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toanthang.me/research/schema.json",
  "title": "VN-PropFin-Eval Benchmark Instance Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "test_id",
      "category",
      "source_document_id",
      "context_snippet",
      "query",
      "expected_ground_truth"
    ],
    "properties": {
      "test_id": {
        "type": "string",
        "pattern": "^VN-(FIN|LAW)-[0-9]{4}-[0-9]{3}$"
      },
      "category": {
        "type": "string",
        "enum": [
          "multi_tier_amortization_and_citation",
          "deferred_construction_cashflow",
          "maintenance_fee_calculation",
          "floating_rate_amortization",
          "compounding_discount_cascade",
          "statutory_citation_grounding",
          "temporal_policy_disambiguation"
        ]
      },
      "source_document_id": {
        "type": "string"
      },
      "context_snippet": {
        "type": "string"
      },
      "query": {
        "type": "string"
      },
      "expected_ground_truth": {
        "type": "object",
        "required": [
          "required_citations",
          "forbidden_hallucinations"
        ],
        "properties": {
          "base_price_vnd": {
            "type": "number"
          },
          "upfront_discount_rate": {
            "type": "number"
          },
          "early_cashflow_annual_rate": {
            "type": "number"
          },
          "early_payment_days": {
            "type": "integer"
          },
          "early_payment_ratio": {
            "type": "number"
          },
          "net_payable_pre_vat_vnd": {
            "type": "number"
          },
          "required_citations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "forbidden_hallucinations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
